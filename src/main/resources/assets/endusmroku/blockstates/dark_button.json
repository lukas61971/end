        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "east",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed",
        "y": 90,
        "x": 90
      }
