{
  "multipart": [
    {
      "when": {
        "face": "ceiling",
        "powered": "false"
      },
      "apply": {
        "model": "endusmroku:block/dark_button",
        "x": 180
      }
    },
    {
      "when": {
        "face": "ceiling",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed",
        "x": 180
      }
    },
    {
      "when": {
        "face": "floor",
        "powered": "false"
      },
      "apply": {
        "model": "endusmroku:block/dark_button"
      }
    },
    {
      "when": {
        "face": "floor",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed"
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "north",
        "powered": "false"
      },
      "apply": {
        "model": "endusmroku:block/dark_button",
        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "north",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed",
        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "south",
        "powered": "false"
      },
      "apply": {
        "model": "endusmroku:block/dark_button",
        "y": 180,
        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "south",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed",
        "y": 180,
        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "west",
        "powered": "false"
      },
      "apply": {
        "model": "endusmroku:block/dark_button",
        "y": 270,
        "x": 90
      }
    },
    {
      "when": {
        "face": "wall",
        "facing": "west",
        "powered": "true"
      },
      "apply": {
        "model": "endusmroku:block/dark_button_pressed",
        "y": 270,
        "x": 90
